/uploads/
/uploads-test/
/private-uploads/
*.log
logs/
tmp/

# ── Env (commit only the examples) ──────────────────────────────────
.env
.env.*
!.env.example
!.env.test.example

# ── Editor / OS noise ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

