# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL of the frontend (used in emails / links)
APP_URL=http://localhost:3000
# Public URL of this API
API_URL=http://localhost:5000

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/planthaat?schema=public"

# ── CORS / cookies ──────────────────────────────────────────────────
# Comma-separated allow-list. Never use "*".
CORS_ORIGINS=http://localhost:3000
# Optional: set to ".planthaat.com" when frontend and API share a parent domain.
# COOKIE_DOMAIN=

# Shared secret with the Next.js BFF. When set, requests carrying a matching
# X-BFF-Key header may supply the real client IP via X-Forwarded-For.
# Required in production (min 32 chars); leave unset for direct API access.
BFF_SHARED_SECRET=

# ── JWT / sessions ──────────────────────────────────────────────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-openssl-rand-base64-48
# Access token TTL in seconds (15 minutes)
JWT_ACCESS_TTL=900
JWT_ISSUER=planthaat
JWT_AUDIENCE=planthaat-web
REFRESH_TTL_DAYS=30
# Benign parallel-refresh window (seconds)
REFRESH_REUSE_GRACE_SECONDS=10

# ── Encryption (32-byte base64: openssl rand -base64 32) ────────────
DATA_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# ── Mail ────────────────────────────────────────────────────────────
# log | smtp
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PlantHaat <no-reply@planthaat.local>"

# ── Storage ─────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Swagger ─────────────────────────────────────────────────────────
ENABLE_SWAGGER=true

# ── Seed admin (used only by prisma/seed.ts) ────────────────────────
ADMIN_EMAIL=admin@planthaat.local
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=PlantHaat Admin

# ── Throttling ──────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
