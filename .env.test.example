# Copy to .env.test and point DATABASE_URL at a SEPARATE test database.
# Tests refuse to run against the development database.
NODE_ENV=test
PORT=0
DATABASE_URL="postgresql://user:password@localhost:5432/planthaat_test?schema=public"
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_SECRET=change-me-test-access-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_ISSUER=planthaat
JWT_AUDIENCE=planthaat-web
REFRESH_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
DATA_ENCRYPTION_KEY=change-me-test-encryption-key-base64-value=

MAIL_TRANSPORT=log
MAIL_FROM="PlantHaat <no-reply@planthaat.test>"
STORAGE_DRIVER=local
UPLOAD_DIR=uploads-test
ENABLE_SWAGGER=false

ADMIN_EMAIL=admin@planthaat.test
ADMIN_PASSWORD=change-me-test-password
ADMIN_NAME=Test Admin

THROTTLE_TTL=60
THROTTLE_LIMIT=1000
