generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── ENUMS ─────────────────────────

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SellerStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerType {
  NURSERY
  INDIVIDUAL_GROWER
  RESELLER
}

enum SellerDocumentType {
  NID_FRONT
  NID_BACK
  TRADE_LICENSE
  NURSERY_PHOTO
  OTHER
}

enum PayoutMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  REMOVED
}

enum LightRequirement {
  FULL_SUN
  PARTIAL_SHADE
  SHADE
  BRIGHT_INDIRECT
  LOW_LIGHT
}

enum WateringFrequency {
  DAILY
  EVERY_2_3_DAYS
  WEEKLY
  FORTNIGHTLY
  MINIMAL
}

enum CareDifficulty {
  EASY
  MODERATE
  HARD
}

enum InventoryReason {
  INITIAL
  RESTOCK
  ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED_DELIVERY
}

// A REPLACEMENT is created when a complaint is resolved as a replacement. It
// follows the same state machine but carries zero prices, no payment and no
// commission, and is excluded from revenue analytics / seller earnings.
enum ShopOrderKind {
  ORDER
  REPLACEMENT
}

enum CodRiskStatus {
  OK
  WATCH
  RESTRICTED
  BLOCKED
}

enum CityScope {
  CITY
  OUTSIDE
  NA
}

enum AreaScope {
  ALL
  CITY
  OUTSIDE
}

enum DeliveryCondition {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum DeliveryPaymentMode {
  COD_AND_ADVANCE
  COD_ONLY
  ADVANCE_ONLY
}

enum SteadfastLocationKind {
  DISTRICT
  DHAKA_CITY
  DHAKA_SUBURBAN
}

enum DhakaZone {
  CITY
  SUBURBAN
}

enum ThanaClassificationSource {
  DEFAULT_UNVERIFIED
  ADMIN_VERIFIED
}

enum CourierQuoteSource {
  LIVE
  IMPORTED
  ADMIN
}

enum DeliveryQuoteSource {
  LIVE
  CACHE
  STALE
  OVERRIDE
  FALLBACK
}

enum CancelledBy {
  CUSTOMER
  SELLER
  ADMIN
  SYSTEM
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  COD
  ADVANCE
  PIPRAPAY
  BKASH
  NAGAD
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum ComplaintType {
  DAMAGED_PLANT
  WRONG_ITEM
  NOT_AS_DESCRIBED
  NOT_DELIVERED
  LATE_DELIVERY
  OTHER
}

enum ComplaintStatus {
  OPEN
  SELLER_RESPONDED
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_REPLACEMENT
  REJECTED
  CLOSED
}

enum DisputeDecision {
  PENDING
  REJECTED
  REFUND_FULL
  REFUND_PARTIAL
  RETURN_TO_SELLER
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum ReportStatus {
  OPEN
  RESOLVED_HIDDEN
  RESOLVED_KEPT
}

// Shared visibility status for questions, answers and replies.
enum ContentStatus {
  VISIBLE
  HIDDEN
}

enum ContentReportTargetType {
  QUESTION
  ANSWER
  REPLY
  REVIEW
}

// Ledger amount sign: positive = platform owes seller, negative = seller owes platform.
enum LedgerEntryType {
  ORDER_EARNING
  COD_COMMISSION_DUE
  PAYOUT
  DUES_PAYMENT
  REFUND_REVERSAL
  ADJUSTMENT
  // Part 4 settlement ledger
  PAYMENT_RECEIVED
  SELLER_PENDING
  SELLER_RELEASE
  COMMISSION
  DISPUTE_HOLD
  DISPUTE_RELEASE
  WITHDRAWAL_RESERVE
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  COD_DUES_ACCRUAL
  COD_DUES_PAYMENT
  REFUND_PAYABLE_CREATED
  REFUND_PAID
  ADJUSTMENT_DEBIT
  ADJUSTMENT_CREDIT
}

enum LedgerAccount {
  BUYER_RECEIPTS
  PLATFORM_HOLDINGS
  SELLER_PENDING
  SELLER_AVAILABLE
  SELLER_ON_HOLD
  SELLER_WITHDRAWAL_RESERVED
  SELLER_PAID_OUT
  REFUND_PAYABLE
  REFUNDS_PAID
  PLATFORM_COMMISSION
  COD_DUES
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REJECTED
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  SELLER
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  CANCELLATION_REQUESTED
  CANCELLATION_RESPONDED
  NEW_MESSAGE
  SELLER_APPROVED
  SELLER_REJECTED
  SHOP_SUSPENDED
  SHOP_REACTIVATED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  LOW_STOCK
  REVIEW_RECEIVED
  COMPLAINT_UPDATED
  PAYOUT_PROCESSED
  ANNOUNCEMENT
  QUESTION_ASKED
  QUESTION_ANSWERED
  COD_RISK_FLAG
  REPLY_RECEIVED
  ORDER_DELAYED
  ORDER_STUCK
  FALSE_DELIVERY_FLAG
  REPLACEMENT_CREATED
  ORDERS_BULK_CANCELLED
  SYSTEM
}

enum AnnouncementAudience {
  ALL
  CUSTOMERS
  SELLERS
}

enum HomepageSectionType {
  FEATURED_CATEGORIES
  FEATURED_PRODUCTS
  FEATURED_SHOPS
  NEW_ARRIVALS
  BANNER_STRIP
}

// ───────────────────────── AUTH & USERS ─────────────────────────

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  phone             String?    @unique
  passwordHash      String
  name              String
  avatarUrl         String?
  role              Role       @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  notificationPrefs Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  sellerProfile   SellerProfile?
  refreshSessions RefreshSession[]
  authTokens      AuthToken[]
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  complaints      Complaint[]
  notifications   Notification[]
  conversations   Conversation[]
  questions       ProductQuestion[] @relation("UserQuestions")
  answers         QuestionAnswer[]  @relation("UserAnswers")
  replies         Reply[]           @relation("UserReplies")

  @@index([role, status])
  @@index([createdAt])
}

model RefreshSession {
  id            String    @id @default(uuid())
  userId        String
  familyId      String
  tokenHash     String    @unique
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  absoluteExpiresAt DateTime?
  rotatedAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ───────────────────────── LOCATION ─────────────────────────

model District {
  id       Int    @id @default(autoincrement())
  name     String @unique
  nameBn   String
  division String
  insideDhaka Boolean @default(false)
  // Admin-editable mapping to Steadfast's destination id. Dhaka stays null:
  // its destination depends on the chosen thana (1 = City, 18 = Sub-Urban).
  steadfastLocationId Int?

  addresses Address[]
  orders    Order[]
  zoneLinks ZoneDistrict[]
  thanas    Thana[]
  pickupShops Shop[]
  steadfastLocation SteadfastLocation? @relation(fields: [steadfastLocationId], references: [id], onDelete: SetNull)

  @@index([steadfastLocationId])
}

model SteadfastLocation {
  id   Int                   @id
  name String
  kind SteadfastLocationKind
  createdAt DateTime @default(now())

  districts District[]
}

model Thana {
  id                     String  @id @default(uuid())
  steadfastPoliceStationId Int?   @unique
  name                   String
  nameBn                 String?
  districtId             Int
  dhakaZone              DhakaZone?
  classificationSource   ThanaClassificationSource @default(DEFAULT_UNVERIFIED)
  selectableByCustomer   Boolean @default(true)
  isActive               Boolean @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  addresses Address[]
  shopPickups Shop[] @relation("ShopPickupThana")

  @@index([districtId])
  @@index([dhakaZone])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  districtId    Int
  thanaId       String?
  area          String
  addressLine   String
  postalCode    String?
  cityScope     CityScope @default(NA)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])
  thana    Thana?   @relation(fields: [thanaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([thanaId])
}

// COD risk is keyed by the normalized phone (phones are unverified, so this is
// a deterrent, not proof of identity). The address fingerprint is a secondary
// signal when a repeat offender uses a new phone at the same address.
model PhoneRiskProfile {
  id                 String        @id @default(uuid())
  phoneNormalized    String        @unique
  failedCount        Int           @default(0)
  deliveredCount     Int           @default(0)
  lastEventAt        DateTime?
  status             CodRiskStatus @default(OK)
  note               String?
  setById            String?
  isWhitelisted      Boolean       @default(false)
  addressFingerprint String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([addressFingerprint])
}

// ───────────────────────── SELLERS & SHOPS ─────────────────────────

model SellerProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  sellerType      SellerType   @default(NURSERY)
  businessName    String
  contactPhone    String
  tradeLicenseNo  String?
  businessAddress String
  status          SellerStatus @default(DRAFT)
  rejectionReason String?
  adminNotes      String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  verifiedAt      DateTime?
  // Number of DELIVERED orders the customer reported as NOT_DELIVERED.
  falseDeliveryFlags Int      @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       SellerDocument[]
  payoutAccounts  SellerPayoutAccount[]
  shops           Shop[]
  ledgerEntries   LedgerEntry[]
  payouts         Payout[]
  commissionRules CommissionRule[]

  @@index([status, submittedAt])
}

model SellerDocument {
  id              String             @id @default(uuid())
  sellerProfileId String
  type            SellerDocumentType
  fileKey         String
  createdAt       DateTime           @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
}

model SellerPayoutAccount {
  id               String       @id @default(uuid())
  sellerProfileId  String
  method           PayoutMethod
  accountName      String
  accountNumberEnc String
  accountMasked    String
  isDefault        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
}

model Shop {
  id               String     @id @default(uuid())
  sellerProfileId  String
  name             String
  slug             String     @unique
  description      String?    @db.Text
  logoUrl          String?
  bannerUrl        String?
  phone            String?
  district         String?
  // Pickup origin used for courier quotes. pickupDistrictId is preferred;
  // legacy shops fall back to matching the free-text district name.
  pickupDistrictId Int?
  pickupThanaId    String?
  address          String?
  latitude         Decimal?   @db.Decimal(9, 6)
  longitude        Decimal?   @db.Decimal(9, 6)
  status           ShopStatus @default(PENDING)
  isOnVacation     Boolean    @default(false)
  vacationUntil    DateTime?
  vacationMessage  String?
  suspensionReason String?
  ratingAvg        Decimal    @default(0) @db.Decimal(3, 2)
  ratingCount      Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  approvedAt       DateTime?
  suspendedAt      DateTime?

  sellerProfile SellerProfile    @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  pickupDistrict District?       @relation(fields: [pickupDistrictId], references: [id], onDelete: SetNull)
  pickupThana    Thana?          @relation("ShopPickupThana", fields: [pickupThanaId], references: [id], onDelete: SetNull)
  products      Product[]
  shopOrders    ShopOrder[]
  deliveryZones ShopDeliveryZone[]
  reviews       Review[]
  complaints    Complaint[]
  conversations Conversation[]

  @@index([status])
  @@index([sellerProfileId])
  @@index([pickupDistrictId])
  @@index([pickupThanaId])
}

model ShopDeliveryZone {
  id                String   @id @default(uuid())
  shopId            String
  name              String
  isNationwide      Boolean  @default(false)
  charge            Decimal  @db.Decimal(10, 2)
  // Seller-funded free delivery. `charge` is kept for history only and is no
  // longer used to price a quote (the courier rate is authoritative).
  freeDeliveryEnabled Boolean @default(false)
  freeDeliveryAbove Decimal? @db.Decimal(12, 2)
  estimatedDaysMin  Int      @default(1)
  estimatedDaysMax  Int      @default(3)
  isActive          Boolean  @default(true)
  condition         DeliveryCondition?
  paymentMode       DeliveryPaymentMode  @default(COD_AND_ADVANCE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  districts ZoneDistrict[]

  @@unique([shopId, condition])
  @@index([shopId])
}

model ZoneDistrict {
  zoneId     String
  districtId Int
  areaScope  AreaScope @default(ALL)

  zone     ShopDeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  district District         @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@id([zoneId, districtId])
  @@index([districtId])
}

// Cached Steadfast quotes keyed by the two location ids and the rounded weight
// step. Admin overrides (isOverride=true) always win and are never refreshed.
model CourierQuoteCache {
  id              String             @id @default(uuid())
  fromSteadfastId Int
  toSteadfastId   Int
  weightStep      Decimal            @db.Decimal(6, 2)
  charge          Decimal?           @db.Decimal(10, 2)
  available       Boolean            @default(false)
  lane            String?
  base            Decimal?           @db.Decimal(10, 2)
  weightExtra     Decimal            @default(0) @db.Decimal(10, 2)
  fetchedAt       DateTime           @default(now())
  source          CourierQuoteSource @default(LIVE)
  isOverride      Boolean            @default(false)

  @@unique([fromSteadfastId, toSteadfastId, weightStep])
  @@index([fromSteadfastId, toSteadfastId])
  @@index([isOverride])
}

// ───────────────────────── CATALOG ─────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String
  nameBn    String?
  slug      String   @unique
  parentId  String?
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  commissionRules CommissionRule[]

  @@index([parentId])
}

model Product {
  id               String             @id @default(uuid())
  shopId           String
  categoryId       String
  name             String
  nameBn           String?
  slug             String             @unique
  scientificName   String?
  description      String             @db.Text
  careInstructions String?            @db.Text
  lightRequirement LightRequirement?
  wateringFrequency WateringFrequency?
  careDifficulty   CareDifficulty?
  isIndoor         Boolean?
  isPetSafe        Boolean?
  matureHeightCm   Int?
  tags             String[]
  careDetails      Json?
  // Packed weight (incl. pot/packaging) used for the courier quote. Whole-taka
  // seller extra charge applied after a quantity threshold.
  weightKg            Decimal?           @db.Decimal(7, 2)
  extraChargeAfterQty Int?
  extraChargePerUnit  Decimal?           @db.Decimal(10, 2)
  status           ProductStatus      @default(DRAFT)
  rejectionReason  String?
  publishedAt      DateTime?
  // Denormalized, kept in sync inside the same transaction as variant/stock changes
  minPrice         Decimal?           @db.Decimal(12, 2)
  maxPrice         Decimal?           @db.Decimal(12, 2)
  inStock          Boolean            @default(false)
  hasDiscount      Boolean            @default(false)
  ratingAvg        Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount      Int                @default(0)
  soldCount        Int                @default(0)
  viewCount        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  questions     ProductQuestion[]

  @@index([shopId, status])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([status, minPrice])
  @@index([status, soldCount])
  @@index([status, hasDiscount])
}

model ProductVariant {
  id               String   @id @default(uuid())
  productId        String
  sku              String?  @unique
  name             String
  sizeLabel        String?
  heightCm         Int?
  potType          String?
  potSizeInch      Decimal? @db.Decimal(5, 1)
  price            Decimal  @db.Decimal(12, 2)
  compareAtPrice   Decimal? @db.Decimal(12, 2)
  stockQty         Int      @default(0)
  lowStockThreshold Int     @default(3)
  weightGrams      Int?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model InventoryLog {
  id            String          @id @default(uuid())
  variantId     String
  delta         Int
  stockAfter    Int
  reason        InventoryReason
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

// ───────────────────────── CART ─────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  // Unit price when the line was added/updated, so the cart can flag changes.
  priceSnapshot Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ───────────────────────── ORDERS ─────────────────────────
// Order     = one checkout by a customer (may span several shops)
// ShopOrder = the slice of that checkout belonging to one shop; each has its own status, delivery, commission

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String        @unique
  customerId          String
  idempotencyKey      String?
  contactName         String
  contactPhone        String
  shippingDistrictId  Int
  shippingDistrictName String
  shippingArea        String
  shippingAddressLine String
  shippingPostalCode  String?
  deliveryNote        String?
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(PENDING)
  subtotal            Decimal       @db.Decimal(12, 2)
  deliveryTotal       Decimal       @db.Decimal(12, 2)
  discountTotal       Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal       @db.Decimal(12, 2)
  currency            String        @default("BDT")
  placedAt            DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer         User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingDistrict District    @relation(fields: [shippingDistrictId], references: [id])
  shopOrders       ShopOrder[]
  payments         Payment[]
  paymentIntent    PaymentIntent?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, placedAt])
}

model ShopOrder {
  id                    String        @id @default(uuid())
  shopOrderNumber       String        @unique
  orderId               String
  shopId                String
  kind                  ShopOrderKind @default(ORDER)
  parentShopOrderId     String?
  status                OrderStatus   @default(PENDING)
  subtotal              Decimal     @db.Decimal(12, 2)
  deliveryCharge        Decimal     @db.Decimal(12, 2)
  total                 Decimal     @db.Decimal(12, 2)
  commissionAmount      Decimal     @db.Decimal(12, 2)
  sellerNetAmount       Decimal     @db.Decimal(12, 2)
  // Delivery-quote snapshot. deliveryCharge remains the amount the customer
  // actually paid (0 when free delivery applied).
  courierCharge         Decimal?    @db.Decimal(12, 2)
  sellerExtraCharge     Decimal?    @db.Decimal(12, 2)
  parcelWeightKg        Decimal?    @db.Decimal(7, 2)
  courierLane           String?
  quoteSource           DeliveryQuoteSource?
  quoteFetchedAt        DateTime?
  freeDeliveryApplied   Boolean     @default(false)
  courierName           String?
  trackingCode          String?
  estimatedDeliveryFrom DateTime?
  estimatedDeliveryTo   DateTime?
  sellerNote            String?
  // Optional note recorded by the seller when marking the order DELIVERED.
  deliveryNote          String?
  confirmedAt           DateTime?
  packedAt              DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  /* Part 4 settlement: release snapshot + completion, delivery proof actor. */
  releaseAt              DateTime?
  fundsReleasedAt        DateTime?
  deliveryVerifiedById   String?
  deliveryProofUrl       String?
  deliveryProofs         ShopOrderDeliveryProof[]
  cancelledAt           DateTime?
  cancelledBy           CancelledBy?
  cancelReason          String?
  // Stuck-order cron bookkeeping (reminders every 24h, max 3, then a flag).
  delayNotifiedAt       DateTime?
  stuckReminderCount    Int       @default(0)
  stuckLastRemindedAt   DateTime?
  stuckFlaggedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop                 Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  parent               ShopOrder?           @relation("ShopOrderReplacement", fields: [parentShopOrderId], references: [id], onDelete: SetNull)
  replacements         ShopOrder[]          @relation("ShopOrderReplacement")
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  cancellationRequests CancellationRequest[]
  complaints           Complaint[]
  refunds              Refund[]
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  paymentAllocation    PaymentIntentAllocation?

  @@index([shopId, status, createdAt])
  @@index([orderId])
  @@index([status, createdAt])
  @@unique([parentShopOrderId])
  @@index([kind, status])
  @@index([status, estimatedDeliveryTo])
  @@index([status, releaseAt])
}

model OrderItem {
  id               String   @id @default(uuid())
  shopOrderId      String
  productId        String?
  variantId        String?
  productName      String
  variantName      String
  imageUrl         String?
  unitPrice        Decimal  @db.Decimal(12, 2)
  quantity         Int
  lineTotal        Decimal  @db.Decimal(12, 2)
  commissionRate   Decimal  @db.Decimal(5, 2)
  commissionAmount Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  shopOrder  ShopOrder       @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review     Review?
  complaints Complaint[]

  @@index([shopOrderId])
  @@index([productId])
}

model OrderStatusHistory {
  id            String      @id @default(uuid())
  shopOrderId   String
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedById   String?
  changedByRole Role?
  note          String?
  createdAt     DateTime    @default(now())

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)

  @@index([shopOrderId, createdAt])
}

model CancellationRequest {
  id           String                    @id @default(uuid())
  shopOrderId  String
  requestedById String
  reason       String
  status       CancellationRequestStatus @default(PENDING)
  respondedById String?
  responseNote String?
  respondedAt  DateTime?
  createdAt    DateTime                  @default(now())

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)

  @@index([shopOrderId, status])
}

// ───────────────────────── PAYMENTS (COD used now; gateways later) ─────────────────────────
// COD: one Payment per ShopOrder (each seller collects own cash).
// Online: one Payment per Order (shopOrderId null), platform collects, then pays sellers via Payout.

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  shopOrderId     String?
  method          PaymentMethod
  provider        String?
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("BDT")
  providerTxnId   String?       @unique
  providerPayload Json?
  paidAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopOrder ShopOrder? @relation(fields: [shopOrderId], references: [id], onDelete: SetNull)
  refunds   Refund[]

  @@index([orderId])
  @@index([shopOrderId])
  @@index([status, createdAt])
}

enum PaymentIntentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REJECTED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RefundObligationStatus {
  REFUND_REQUIRED
  REFUND_PAYABLE
  COMPLETED
}

model PaymentIntent {
  id                String              @id @default(uuid())
  orderId           String              @unique
  amountDue         Decimal             @db.Decimal(12, 2)
  currency          String              @default("BDT")
  status            PaymentIntentStatus @default(UNPAID)
  providerSnapshot  Json
  expiresAt         DateTime
  paidAt            DateTime?
  slaAlertedAt      DateTime?
  refundedAmount    Decimal             @default(0) @db.Decimal(12, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submissions        PaymentSubmission[]
  allocations        PaymentIntentAllocation[]
  refundObligations  RefundObligation[]

  @@index([status, expiresAt])
  @@index([status, createdAt])
}

model PaymentIntentAllocation {
  id          String        @id @default(uuid())
  intentId    String
  shopOrderId String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())

  intent    PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  shopOrder ShopOrder     @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)

  @@index([intentId])
}

model PaymentSubmission {
  id            String                  @id @default(uuid())
  intentId      String
  provider      String
  trxId         String
  senderNumber  String
  proofUrl      String?
  status        PaymentSubmissionStatus @default(PENDING)
  amountReceived Decimal?               @db.Decimal(12, 2)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime                @default(now())

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@unique([provider, trxId])
  @@index([intentId, createdAt])
  @@index([status, createdAt])
}

model RefundObligation {
  id             String                 @id @default(uuid())
  intentId       String
  shopOrderId    String?
  amount         Decimal                @db.Decimal(12, 2)
  status         RefundObligationStatus @default(REFUND_REQUIRED)
  reason         String
  refundTrxId    String?
  completedById  String?
  completedAt    DateTime?
  createdAt      DateTime               @default(now())

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([intentId])
}

// Dedup log for gateway callbacks/webhooks (prevents duplicate processing).
model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model Refund {
  id            String       @id @default(uuid())
  shopOrderId   String
  paymentId     String?
  complaintId   String?
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        RefundStatus @default(REQUESTED)
  method        PaymentMethod?
  reference     String?
  note          String?
  requestedById String
  processedById String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  shopOrder     ShopOrder    @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  complaint     Complaint?   @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([shopOrderId])
  @@index([status, createdAt])
}

// ───────────────────────── COMMISSION, LEDGER, PAYOUTS ─────────────────────────

model CommissionRule {
  id              String          @id @default(uuid())
  scope           CommissionScope
  categoryId      String?
  sellerProfileId String?
  ratePercent     Decimal         @db.Decimal(5, 2)
  isActive        Boolean         @default(true)
  effectiveFrom   DateTime        @default(now())
  createdById     String?
  createdAt       DateTime        @default(now())

  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
}

model LedgerEntry {
  id              String           @id @default(uuid())
  sellerProfileId String?
  shopOrderId     String?
  payoutId        String?
  refundId        String?
  orderId         String?
  paymentId       String?
  disputeId       String?
  withdrawalId    String?
  type            LedgerEntryType
  account         LedgerAccount?
  amount          Decimal          @db.Decimal(12, 2)
  description     String?
  createdById     String?
  createdAt       DateTime         @default(now())
  // Part 4: deterministic release time snapshot and idempotency.
  releaseAt       DateTime?
  batchId         String?
  idempotencyKey  String?          @unique
  // Positive legacy entries unlock after payout.holdHours past delivery (null = immediate/negative).
  availableAt     DateTime?

  sellerProfile SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  shopOrder     ShopOrder?    @relation(fields: [shopOrderId], references: [id], onDelete: SetNull)
  payout        Payout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  refund        Refund?       @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([sellerProfileId, createdAt])
  @@index([shopOrderId])
  @@index([refundId])
  @@index([account, releaseAt])
  @@index([batchId])
}

model Payout {
  id              String       @id @default(uuid())
  payoutNumber    String       @unique
  sellerProfileId String
  amount          Decimal      @db.Decimal(12, 2)
  status          PayoutStatus @default(PENDING)
  method          PayoutMethod?
  accountMasked   String?
  reference       String?
  note            String?
  /* Part 4 withdrawal requests (seller-initiated) reuse this table. */
  requestedById   String?
  rejectionReason String?
  balanceSnapshot Decimal?     @db.Decimal(12, 2)
  idempotencyKey  String?      @unique
  periodFrom      DateTime?
  periodTo        DateTime?
  processedById   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([sellerProfileId, status])
  @@index([status, createdAt])
}

// ───────────────────────── ENGAGEMENT: WISHLIST, REVIEWS, COMPLAINTS ─────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id             String       @id @default(uuid())
  productId      String
  shopId         String
  customerId     String
  orderItemId    String       @unique
  rating         Int
  title          String?
  comment        String?      @db.Text
  status         ReviewStatus @default(VISIBLE)
  // @deprecated superseded by Reply rows (isSellerReply = true); kept for compatibility.
  sellerReply    String?
  // @deprecated see sellerReply.
  sellerRepliedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer  User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  images    ReviewImage[]
  replies   Reply[]

  @@index([productId, status, createdAt])
  @@index([shopId, status])
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// ───────────────────────── Q&A ─────────────────────────

model ProductQuestion {
  id        String        @id @default(uuid())
  productId String
  authorId  String
  body      String        @db.Text
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User             @relation("UserQuestions", fields: [authorId], references: [id], onDelete: Cascade)
  answers QuestionAnswer[]

  @@index([productId, status, createdAt])
  @@index([authorId, productId, createdAt])
}

model QuestionAnswer {
  id             String        @id @default(uuid())
  questionId     String
  authorId       String
  body           String        @db.Text
  isSellerAnswer Boolean       @default(false)
  status         ContentStatus @default(VISIBLE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User            @relation("UserAnswers", fields: [authorId], references: [id], onDelete: Cascade)
  replies  Reply[]

  @@index([questionId, status, createdAt])
}

// A reply belongs to exactly one of an answer or a review (enforced by a CHECK
// constraint added in the migration) and never nests deeper than one level.
model Reply {
  id            String        @id @default(uuid())
  answerId      String?
  reviewId      String?
  authorId      String
  body          String        @db.Text
  isSellerReply Boolean       @default(false)
  status        ContentStatus @default(VISIBLE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  answer QuestionAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  review Review?         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User            @relation("UserReplies", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([answerId, status, createdAt])
  @@index([reviewId, status, createdAt])
}

// One report queue for questions, answers, replies and reviews.
model ContentReport {
  id           String                  @id @default(uuid())
  targetType   ContentReportTargetType
  targetId     String
  reporterId   String
  reason       String
  status       ReportStatus            @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime                @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model Complaint {
  id             String          @id @default(uuid())
  ticketNumber   String          @unique
  shopOrderId    String
  orderItemId    String?
  customerId     String
  shopId         String
  type           ComplaintType
  description    String          @db.Text
  status         ComplaintStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  /* Part 4 dispute/settlement fields (null for pre-Part-4 complaints). */
  decision               DisputeDecision @default(PENDING)
  sellerResponseDueAt    DateTime?
  sellerRespondedAt      DateTime?
  fundsHeldAt            DateTime?
  decidedAt              DateTime?
  refundAmount           Decimal?        @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  shopOrder   ShopOrder             @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customer    User                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shop        Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  attachments ComplaintAttachment[]
  comments    ComplaintComment[]
  refunds     Refund[]

  @@index([status, createdAt])
  @@index([shopId, status])
  @@index([customerId])
}

model ComplaintAttachment {
  id          String   @id @default(uuid())
  complaintId String
  url         String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintComment {
  id          String   @id @default(uuid())
  complaintId String
  authorId    String
  authorRole  Role
  body        String   @db.Text
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  attachments ComplaintCommentAttachment[]

  @@index([complaintId, createdAt])
}

model ComplaintCommentAttachment {
  id          String   @id @default(uuid())
  commentId   String
  url         String
  createdAt   DateTime @default(now())

  comment ComplaintComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

model ShopOrderDeliveryProof {
  id          String   @id @default(uuid())
  shopOrderId String
  url         String
  createdAt   DateTime @default(now())

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)

  @@index([shopOrderId])
}

// ───────────────────────── MESSAGING (schema only — NOT implemented in v1) ─────────────────────────

model Conversation {
  id            String   @id @default(uuid())
  customerId    String
  shopId        String
  productId     String?
  shopOrderId   String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  customer User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([customerId, shopId])
  @@index([shopId, lastMessageAt])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     Role
  body           String    @db.Text
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ───────────────────────── NOTIFICATIONS, ADMIN, CONTENT ─────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String               @db.Text
  audience    AnnouncementAudience @default(ALL)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([audience, publishedAt])
}

model Banner {
  id                  String    @id @default(uuid())
  title               String?
  imageUrl            String
  linkUrl             String?
  placement           String    @default("HOME_HERO")
  sortOrder           Int       @default(0)
  isActive            Boolean   @default(true)
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  imagePublicId       String?
  imageWidth          Int?
  imageHeight         Int?
  mobileImageUrl      String?
  mobileImagePublicId String?
  mobileImageWidth    Int?
  mobileImageHeight   Int?
  imageAltBn          String?
  imageAltEn          String?
  focalX              Int       @default(50)
  focalY              Int       @default(50)
  mobileFocalX        Int       @default(50)
  mobileFocalY        Int       @default(50)
  overlayEnabled      Boolean   @default(false)
  headlineBn          String?
  headlineEn          String?
  subtextBn           String?
  subtextEn           String?
  textColor           String?
  scrimColor          String?   @default("#0B2116")
  scrimOpacity        Int       @default(35)
  desktopPosition     String?   @default("BOTTOM_LEFT")
  mobilePosition      String?   @default("BOTTOM_LEFT")
  desktopAlign        String?   @default("left")
  mobileAlign         String?   @default("left")
  buttonEnabled       Boolean   @default(false)
  buttonLabelBn       String?
  buttonLabelEn       String?
  buttonHref          String?
  buttonStyle         String?   @default("primary")
  buttonBgColor       String?
  buttonTextColor     String?
  openInNewTab        Boolean   @default(false)
  createdById         String?
  updatedById         String?

  @@index([placement, isActive, sortOrder])
}

model HomepageSection {
  id        String              @id @default(uuid())
  key       String              @unique
  title     String
  titleBn   String?
  type      HomepageSectionType
  itemIds   String[]
  config    Json?
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ------------------------- UPLOADS -------------------------
enum UploadAssetStatus {
  PENDING
  ATTACHED
}

// Every upload is recorded as PENDING; attaching its URL to an entity marks it
// ATTACHED. A cron removes PENDING assets older than 24 h (orphan control).
model UploadedAsset {
  id           String            @id @default(uuid())
  publicId     String
  resourceType String            @default("image")
  url          String?
  purpose      String
  ownerId      String?
  status       UploadAssetStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  attachedAt   DateTime?
  width        Int?
  height       Int?

  @@index([status, createdAt])
  @@index([ownerId])
}
model SystemSettingHistory {
  id          String   @id @default(uuid())
  key         String
  sequence    Int      @default(autoincrement()) @unique
  batchId     String?
  oldValue    Json?
  newValue    Json?
  updatedById String?
  reason      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())


  @@index([key, createdAt])
  @@index([batchId])
  @@index([updatedById])
}
